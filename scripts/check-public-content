PRIVATE_ROOTS = ("plugins/", "profiles/", ".claude-plugin/", ".agents/")
CREDENTIAL_SUFFIXES = {".p12", ".p8", ".pem", ".key", ".pfx", ".mobileprovision"}
EXAMPLE_HOME = re.compile(r"^(?:example(?:2|ish|-work)?|exam|ex|me(?:2|ow)?|fixture|testperson|someone|another-person|other|private|x|y)$", re.I)
EMAIL = re.compile(r"[\w.+%-]+@([\w.-]+\.[A-Za-z]{2,})")
RETINA_IMAGE = re.compile(r"[\w.-]+@[23]x\.(?:png|jpe?g|gif|webp)", re.I)
LINK = re.compile(r"!?\[[^]\n]*\]\(([^)\n]+)\)")


def text_issues(text, private_hashes=None):
    if private_hashes is None:
        private_hashes = PRIVATE_WORD_HASHES
    issues = []
    for number, line in enumerate(text.splitlines(), 1):
        words = re.findall(r"[A-Za-z0-9]+", line.lower())
        candidates = ("-".join(words[start:start + count])
                      for start in range(len(words)) for count in range(1, min(4, len(words) - start) + 1))
        if any(hashlib.sha256(word.encode()).hexdigest() in private_hashes for word in candidates):
            issues.append((number, "private vocabulary"))
        for match in re.finditer(r"/(?:Users|home)/([A-Za-z0-9_-][A-Za-z0-9_.-]*)", line):
            if not EXAMPLE_HOME.fullmatch(match[1]):
                issues.append((number, "personal home directory"))
        for address in EMAIL.finditer(line):
            if RETINA_IMAGE.fullmatch(address[0]):
                continue
            domain = address[1].lower()
            if not (domain in {"github.com", "gitlab.com", "example.com", "example.invalid", "example.org"}
                    or domain.endswith((".example.com", ".example.invalid"))):
                issues.append((number, "non-example email or account address"))
    return sorted(set(issues))


def png_has_metadata(data):
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        return False
    offset = 8
    while offset + 12 <= len(data):
        length = struct.unpack(">I", data[offset:offset + 4])[0]
        kind = data[offset + 4:offset + 8]
        if kind in {b"tEXt", b"zTXt", b"iTXt", b"eXIf"}:
            return True
        offset += length + 12
    return False


def image_has_metadata(data):
    if png_has_metadata(data):
        return True
    if data.startswith(b"icns"):
        offset = 8
        while offset + 8 <= len(data):
            size = struct.unpack(">I", data[offset + 4:offset + 8])[0]
            if size < 8 or offset + size > len(data):
                break
            if png_has_metadata(data[offset + 8:offset + size]):
                return True
            offset += size
    return False


def inspect_file(root, path):
    relative = path.relative_to(root).as_posix()
    issues = [(0, reason) for _, reason in text_issues(relative)]
    if relative.startswith(PRIVATE_ROOTS):
        issues.append((0, "private catalog directory"))
    if path.suffix.lower() in CREDENTIAL_SUFFIXES or (path.name.startswith(".env") and path.name != ".env.example"):
        issues.append((0, "credential/configuration file"))
    if path.is_symlink():
        if not path.resolve().is_relative_to(root.resolve()):
            issues.append((0, "symlink escapes repository"))
        return issues
    data = path.read_bytes()
    if path.suffix.lower() in {".png", ".icns"} and image_has_metadata(data):
        issues.append((0, "image contains text or EXIF metadata"))
    if b"\0" in data:
        return issues
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return issues
    issues.extend(text_issues(text))
    if path.suffix == ".md":
        for number, line in enumerate(text.splitlines(), 1):
            for match in LINK.finditer(line):
                target = match[1].split(' "', 1)[0].strip("<>")
                if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", target) or target.startswith("#"):
                    continue
                target = unquote(target.split("#", 1)[0])
                if not target:
                    continue
                resolved = root / target.lstrip("/") if target.startswith("/") else path.parent / target
                if not resolved.exists():
                    issues.append((number, "broken local Markdown link"))
    return issues


def diagnostic_name(name):
    if text_issues(name):
        return "file-" + hashlib.sha256(name.encode()).hexdigest()[:12]
    return name


def main():
    root = Path(__file__).resolve().parents[1]
    listed = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root)
    paths = sorted(set(listed.decode().split("\0")) - {""})
    failures = []
    inspected = 0
    for name in paths:
        path = root / name
        if not (path.is_file() or path.is_symlink()):
            continue
        inspected += 1
        for line, reason in inspect_file(root, path):
            failures.append(f"{diagnostic_name(name)}:{line}: {reason}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        print(f"Public-content check failed: {len(failures)} issue(s).", file=sys.stderr)
        return 1
    print(f"Public-content check passed: {inspected} files. Run Gitleaks separately for secrets.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
