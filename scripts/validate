#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

"$REPO_ROOT/scripts/validate-static"

CLAUDE_CATALOG="$REPO_ROOT/.claude-plugin/marketplace.json"
CODEX_CATALOG="$REPO_ROOT/.agents/plugins/marketplace.json"

for command in claude codex; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$command" >&2
    exit 69
  fi
done

TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/agent-tooling-validation.XXXXXX")"
CLAUDE_TEST_HOME="$TEST_ROOT/claude-home"
CLAUDE_TEST_CONFIG="$CLAUDE_TEST_HOME/.claude"
CODEX_TEST_HOME="$TEST_ROOT/codex-home"
CODEX_TEST_CONFIG="$TEST_ROOT/codex-config"
mkdir -p "$CLAUDE_TEST_CONFIG" "$CODEX_TEST_HOME" "$CODEX_TEST_CONFIG"
trap 'rm -rf "$TEST_ROOT"' EXIT

claude_plugins="$(jq -r '.plugins[].name' "$CLAUDE_CATALOG" | sort)"
codex_plugins="$(jq -r '.plugins[].name' "$CODEX_CATALOG" | sort)"

printf 'Validating Claude marketplace and plugin packages...\n'
HOME="$CLAUDE_TEST_HOME" CLAUDE_CONFIG_DIR="$CLAUDE_TEST_CONFIG" claude plugin validate "$REPO_ROOT"
for plugin_root in "$REPO_ROOT"/plugins/*; do
  [[ -d "$plugin_root" ]] || continue
  HOME="$CLAUDE_TEST_HOME" CLAUDE_CONFIG_DIR="$CLAUDE_TEST_CONFIG" claude plugin validate "$plugin_root"
done

printf 'Smoke-installing Claude and Codex plugins in isolated homes...\n'
HOME="$CLAUDE_TEST_HOME" CLAUDE_CONFIG_DIR="$CLAUDE_TEST_CONFIG" claude plugin marketplace add "$REPO_ROOT" >/dev/null
while IFS= read -r plugin; do
  [[ -n "$plugin" ]] || continue
  HOME="$CLAUDE_TEST_HOME" CLAUDE_CONFIG_DIR="$CLAUDE_TEST_CONFIG" claude plugin install "$plugin@agent-tooling" --scope user >/dev/null
done <<< "$claude_plugins"

HOME="$CODEX_TEST_HOME" CODEX_HOME="$CODEX_TEST_CONFIG" codex plugin marketplace add "$REPO_ROOT" --json >/dev/null
while IFS= read -r plugin; do
  [[ -n "$plugin" ]] || continue
  HOME="$CODEX_TEST_HOME" CODEX_HOME="$CODEX_TEST_CONFIG" codex plugin add "$plugin@agent-tooling" --json >/dev/null
done <<< "$codex_plugins"

printf 'Native client validation passed.\n'
