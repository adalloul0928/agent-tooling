#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLAUDE_CATALOG="$REPO_ROOT/.claude-plugin/marketplace.json"
CODEX_CATALOG="$REPO_ROOT/.agents/plugins/marketplace.json"

for command in jq node python3 rg agentskills; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$command" >&2
    exit 69
  fi
done

printf 'Validating JSON manifests...\n'
while IFS= read -r json_file; do
  jq -e . "$json_file" >/dev/null
done < <(find "$REPO_ROOT/.agents" "$REPO_ROOT/.claude-plugin" "$REPO_ROOT/plugins" "$REPO_ROOT/profiles" "$REPO_ROOT/schemas" -type f -name '*.json' -print | sort)

claude_plugins="$(jq -r '.plugins[].name' "$CLAUDE_CATALOG" | sort)"
codex_plugins="$(jq -r '.plugins[].name' "$CODEX_CATALOG" | sort)"
if [[ "$claude_plugins" != "$codex_plugins" ]]; then
  printf 'Claude and Codex catalogs publish different plugin names.\n' >&2
  exit 65
fi

printf 'Checking catalogs, adapters, and release policy...\n'
while IFS=$'\t' read -r name claude_source codex_source; do
  if [[ "$claude_source" != ./plugins/* || "$codex_source" != "$claude_source" ]]; then
    printf 'Plugin %s must use the same repository-local source in both catalogs.\n' "$name" >&2
    exit 65
  fi

  plugin_root="$REPO_ROOT/${claude_source#./}"
  canonical_manifest="$plugin_root/plugin.json"
  claude_manifest="$plugin_root/.claude-plugin/plugin.json"
  codex_manifest="$plugin_root/.codex-plugin/plugin.json"
  if [[ ! -f "$canonical_manifest" ]]; then
    printf 'Missing canonical Agent Plugins manifest: %s\n' "$canonical_manifest" >&2
    exit 66
  fi
  if [[ "$(jq -r '.["$schema"]' "$canonical_manifest")" != 'https://agent-plugins.org/schemas/1.0.0/plugin.schema.json' ]]; then
    printf 'Canonical manifest must use the Agent Plugins 1.0.0 schema: %s\n' "$canonical_manifest" >&2
    exit 65
  fi
  if [[ "$(jq -r '.name' "$canonical_manifest")" != "$name" ]]; then
    printf 'Canonical package name mismatch for %s.\n' "$name" >&2
    exit 65
  fi
  if jq -e 'has("version")' "$canonical_manifest" >/dev/null; then
    printf 'Canonical plugin manifest must omit version under Git-revision policy: %s\n' "$canonical_manifest" >&2
    exit 65
  fi
  for manifest in "$claude_manifest" "$codex_manifest"; do
    if [[ ! -f "$manifest" ]]; then
      printf 'Missing adapter manifest: %s\n' "$manifest" >&2
      exit 66
    fi
    jq -e . "$manifest" >/dev/null
    if [[ "$(jq -r '.name' "$manifest")" != "$name" ]]; then
      printf 'Adapter name mismatch for %s.\n' "$name" >&2
      exit 65
    fi
    if jq -e 'has("version")' "$manifest" >/dev/null; then
      printf 'Plugin manifest must omit version under Git-revision policy: %s\n' "$manifest" >&2
      exit 65
    fi
  done

  portable_mcp_config="$plugin_root/mcp.json"
  if [[ -e "$portable_mcp_config" ]]; then
    if [[ ! -f "$portable_mcp_config" || -L "$portable_mcp_config" ]]; then
      printf 'Portable MCP configuration must be a regular non-symlink file: %s\n' "$portable_mcp_config" >&2
      exit 66
    fi
    if [[ "$(jq -r '.["$schema"]' "$portable_mcp_config")" != 'https://agent-plugins.org/schemas/1.0.0/mcp.schema.json' ]]; then
      printf 'Portable MCP configuration must use the Agent Plugins 1.0.0 schema: %s\n' "$portable_mcp_config" >&2
      exit 65
    fi
    if ! jq -e '(keys | sort) == ["$schema", "mcpServers"] and (.mcpServers | type == "object")' "$portable_mcp_config" >/dev/null; then
      printf 'Portable MCP configuration has unsupported top-level fields: %s\n' "$portable_mcp_config" >&2
      exit 65
    fi
    if jq -e '.mcpServers[] | select(.type == "stdio") | .command | test("[[:space:]]")' "$portable_mcp_config" >/dev/null; then
      printf 'Portable MCP commands must be one executable token: %s\n' "$portable_mcp_config" >&2
      exit 65
    fi
    legacy_mcp_config="$plugin_root/.mcp.json"
    if [[ -f "$legacy_mcp_config" ]] && ! jq -e --slurpfile legacy "$legacy_mcp_config" '
      all(.mcpServers | to_entries[]; $legacy[0].mcpServers[.key] == .value)
    ' "$portable_mcp_config" >/dev/null; then
      printf 'Portable MCP entries must match their retained native adapter entries: %s\n' "$portable_mcp_config" >&2
      exit 65
    fi
  fi

  claude_mcp_source="$(jq -r '.mcpServers // empty' "$claude_manifest")"
  codex_mcp_source="$(jq -r '.mcpServers // empty' "$codex_manifest")"
  if [[ "$claude_mcp_source" != "$codex_mcp_source" ]]; then
    printf 'Claude and Codex MCP declarations differ for %s.\n' "$name" >&2
    exit 65
  fi
  if [[ -n "$claude_mcp_source" ]]; then
    if [[ "$claude_mcp_source" != ./* ]]; then
      printf 'Plugin %s must use a repository-local MCP declaration.\n' "$name" >&2
      exit 65
    fi
    mcp_config="$plugin_root/${claude_mcp_source#./}"
    resolved_mcp_config="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$mcp_config")"
    if [[ "$resolved_mcp_config" != "$plugin_root"/* || ! -f "$resolved_mcp_config" ]]; then
      printf 'Invalid MCP declaration for %s: %s\n' "$name" "$claude_mcp_source" >&2
      exit 66
    fi
    if ! jq -e '.mcpServers | type == "object" and length > 0' "$resolved_mcp_config" >/dev/null; then
      printf 'Plugin %s MCP declaration must contain at least one server.\n' "$name" >&2
      exit 65
    fi
    if jq -e '.mcpServers[] | (.args // []) | any(. == "--command")' "$resolved_mcp_config" >/dev/null; then
      printf 'Plugin %s MCP declaration must use argv execution rather than a shell command string.\n' "$name" >&2
      exit 65
    fi
    if rg -n '\$HOME|~/' "$resolved_mcp_config"; then
      printf 'Plugin %s MCP declaration must not contain a machine-dependent home path.\n' "$name" >&2
      exit 65
    fi
  fi

  while IFS= read -r link; do
    resolved="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$link")"
    if [[ "$resolved" != "$plugin_root"/* ]]; then
      printf 'Plugin symlink escapes its package: %s -> %s\n' "$link" "$resolved" >&2
      exit 65
    fi
  done < <(find "$plugin_root" -type l -print | sort)
done < <(
  jq -r --slurpfile codex "$CODEX_CATALOG" '
    .plugins[] as $claude
    | ($codex[0].plugins[] | select(.name == $claude.name)) as $codex_plugin
    | [$claude.name, $claude.source, $codex_plugin.source.path]
    | @tsv
  ' "$CLAUDE_CATALOG"
)

"$REPO_ROOT/scripts/generate-plugin-adapters" --check

if jq -e '.plugins[] | has("version")' "$CLAUDE_CATALOG" >/dev/null; then
  printf 'Claude catalog entries must omit version under Git-revision policy.\n' >&2
  exit 65
fi

printf 'Checking for engine-specific installation paths...\n'
if rg -n '((~|\$HOME|/Users/[^/]+|/home/[^/]+)/\.(claude|codex)(/|$)|(/Users/[^/]+|/home/[^/]+)/(.*\/)?(plugins|skills)/)' "$REPO_ROOT/plugins"; then
  printf 'Found a hard-coded Claude or Codex installation path.\n' >&2
  exit 65
fi

printf 'Validating Agent Skills...\n'
while IFS= read -r skill_file; do
  agentskills validate "$(dirname "$skill_file")"
done < <(find "$REPO_ROOT/plugins" -type f -name SKILL.md -print | sort)

printf 'Validating bundled helper scripts...\n'
while IFS= read -r script; do
  bash -n "$script"
done < <(find "$REPO_ROOT/plugins" -type f -path '*/scripts/*.sh' -print | sort)
while IFS= read -r script; do
  bash -n "$script"
done < <(rg -l '^#!/usr/bin/env bash$' "$REPO_ROOT/scripts" | sort)
while IFS= read -r script; do
  node --check "$script"
done < <(find "$REPO_ROOT/plugins" -type f -path '*/scripts/*.mjs' -print | sort)
while IFS= read -r test_file; do
  node --test "$test_file"
done < <(find "$REPO_ROOT/plugins" -type f -path '*/tests/*.test.mjs' -print | sort)
while IFS= read -r script; do
  PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/agent-tooling-pycache" python3 -m py_compile "$script"
done < <(rg -l '^#!/usr/bin/env python3$' "$REPO_ROOT/scripts" | sort)

PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/agent-tooling-pycache" \
  python3 -m compileall -q "$REPO_ROOT/plugins"
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/agent-tooling-pycache" \
  python3 -m py_compile "$REPO_ROOT/scripts/doctor"
while IFS= read -r profile; do
  "$REPO_ROOT/scripts/doctor" "$profile" --profiles-dir "$REPO_ROOT/profiles" --validate
done < <(find "$REPO_ROOT/profiles" -type f -name '*.json' -print | sort)
python3 -m unittest discover -s "$REPO_ROOT/tests" -p 'test_*.py'

printf 'Static validation passed.\n'
