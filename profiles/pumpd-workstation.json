{
  "$schema": "../schemas/profile.schema.json",
  "schema_version": 1,
  "name": "pumpd-workstation",
  "description": "Effective desired state for PUMPD development on Aren's primary workstation.",
  "extends": [
    "base-workstation.json",
    "pumpd-project.json"
  ],
  "checks": [
    {
      "id": "claude.pumpd-workflows-plugin",
      "kind": "claude_plugin",
      "plugin": "pumpd-workflows@agent-tooling",
      "path": "${project_root}/.claude/settings.json",
      "expected": "enabled"
    },
    {
      "id": "codex.pumpd-workflows-plugin",
      "kind": "codex_plugin",
      "plugin": "pumpd-workflows@agent-tooling",
      "expected": "enabled"
    },
    {
      "id": "claude.cyrus-workflows-plugin",
      "kind": "claude_plugin",
      "plugin": "cyrus-workflows@agent-tooling",
      "path": "${project_root}/.claude/settings.json",
      "expected": "enabled"
    },
    {
      "id": "codex.cyrus-workflows-plugin",
      "kind": "codex_plugin",
      "plugin": "cyrus-workflows@agent-tooling",
      "expected": "enabled"
    },
    {
      "id": "claude.linear-plugin",
      "kind": "claude_plugin",
      "plugin": "linear@claude-plugins-official",
      "path": "${project_root}/.claude/settings.json",
      "expected": "enabled"
    },
    {
      "id": "claude.supabase-plugin",
      "kind": "claude_plugin",
      "plugin": "supabase@claude-plugins-official",
      "path": "${project_root}/.claude/settings.json",
      "expected": "enabled"
    },
    {
      "id": "claude.sentry-plugin",
      "kind": "claude_plugin",
      "plugin": "sentry@claude-plugins-official",
      "path": "${project_root}/.claude/settings.json",
      "expected": "enabled"
    },
    {
      "id": "codex.linear-plugin",
      "kind": "codex_plugin",
      "plugin": "linear@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.supabase-plugin",
      "kind": "codex_plugin",
      "plugin": "supabase@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.sentry-plugin",
      "kind": "codex_plugin",
      "plugin": "sentry@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.github-plugin",
      "kind": "codex_plugin",
      "plugin": "github@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.duplicate-linear-mcp",
      "kind": "codex_mcp",
      "server": "linear",
      "expected": "absent",
      "severity": "warning"
    },
    {
      "id": "codex.duplicate-expo-mcp",
      "kind": "codex_mcp",
      "server": "expo",
      "expected": "absent",
      "severity": "warning"
    },
    {
      "id": "codex.duplicate-ios-simulator-mcp",
      "kind": "codex_mcp",
      "server": "ios-simulator-mcp",
      "expected": "absent",
      "severity": "warning"
    },
    {
      "id": "claude.pumpd-automations-plugin",
      "kind": "claude_plugin",
      "plugin": "pumpd-automations@agent-tooling",
      "expected": "enabled",
      "install": {
        "run": [
          "claude",
          "plugin",
          "install",
          "pumpd-automations@agent-tooling"
        ],
        "note": "Supplies the ten scheduled automation skills (pumpd-sentry-miner, pumpd-tool-radar, etc.). Deliberately user-scoped rather than project-scoped like pumpd-workflows/cyrus-workflows: automations fire unattended in whatever directory the scheduler uses, so a project-scoped plugin would not be active. Note a registered scheduled task carries its own SKILL.md copy under ~/.claude/scheduled-tasks/ and runs without this plugin; the plugin is what makes the automations invocable interactively."
      }
    },
    {
      "id": "codex.pumpd-automations-plugin",
      "kind": "codex_plugin",
      "plugin": "pumpd-automations@agent-tooling",
      "expected": "enabled",
      "severity": "warning",
      "note": "Advisory: owner defers the pumpd-automations install on Codex. (The codex CLI IS installed — it ships inside the ChatGPT desktop app at /Applications/ChatGPT.app/Contents/Resources/codex and is symlinked onto PATH; see the codex.cli-on-path manual check.)"
    }
  ]
}
