{
  "$schema": "../schemas/profile.schema.json",
  "schema_version": 1,
  "name": "pumpd-workstation",
  "description": "Effective desired state for PUMPD development on Aren's primary workstation.",
  "extends": [
    "base-workstation.json",
    "pumpd-project.json"
  ],
  "checks": [
    {
      "id": "claude.linear-plugin",
      "kind": "claude_plugin",
      "plugin": "linear@claude-plugins-official",
      "expected": "enabled"
    },
    {
      "id": "claude.supabase-plugin",
      "kind": "claude_plugin",
      "plugin": "supabase@claude-plugins-official",
      "expected": "enabled"
    },
    {
      "id": "claude.sentry-plugin",
      "kind": "claude_plugin",
      "plugin": "sentry@claude-plugins-official",
      "expected": "enabled"
    },
    {
      "id": "codex.linear-plugin",
      "kind": "codex_plugin",
      "plugin": "linear@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.supabase-plugin",
      "kind": "codex_plugin",
      "plugin": "supabase@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.sentry-plugin",
      "kind": "codex_plugin",
      "plugin": "sentry@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.github-plugin",
      "kind": "codex_plugin",
      "plugin": "github@openai-curated",
      "expected": "enabled"
    },
    {
      "id": "codex.duplicate-linear-mcp",
      "kind": "codex_mcp",
      "server": "linear",
      "expected": "absent",
      "severity": "warning"
    },
    {
      "id": "codex.duplicate-expo-mcp",
      "kind": "codex_mcp",
      "server": "expo",
      "expected": "absent",
      "severity": "warning"
    }
  ]
}
