{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tooling.local/schemas/profile.schema.json",
  "title": "Agent tooling desired-state profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "manual_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manualCheck"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "path",
            "same_file",
            "claude_plugin",
            "claude_marketplace",
            "claude_mcp",
            "claude_setting",
            "codex_plugin",
            "codex_marketplace",
            "codex_mcp",
            "project_claude_mcp",
            "project_codex_mcp"
          ]
        },
        "severity": {
          "enum": ["required", "warning"]
        },
        "expected": {}
      }
    },
    "manualCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    }
  }
}
